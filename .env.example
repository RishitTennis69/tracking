PORT=4173

# Add one or more providers. The app will only run platforms with configured keys.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides.
OPENAI_MODEL=gpt-5-nano
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: enables OpenAI web search in Responses API calls. If the account/model
# does not support it, the server automatically retries without the tool.
OPENAI_USE_WEB_SEARCH=true

# Limits keep scans practical and predictable while testing.
MAX_CRAWL_PAGES=8
MAX_SCAN_PROMPTS=7
